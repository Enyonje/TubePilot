generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Plan {
  FREE
  PRO
  AGENCY
}

// Human approval gate sits between SCRIPT_READY and PRODUCING.
enum VideoStatus {
  DRAFT
  RESEARCHING
  SCRIPTING
  AWAITING_APPROVAL
  APPROVED
  PRODUCING
  RENDERED
  PUBLISHING
  PUBLISHED
  REJECTED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity and tenancy
// Auth.js tables (Account, Session, VerificationToken) arrive with the auth module.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships    Membership[]
  approvedVideos Video[]      @relation("VideoApprover")
  auditLogs      AuditLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  channels     Channel[]
  creditLedger CreditLedger[]
  llmUsage     LlmUsage[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

model Membership {
  id             String     @id @default(uuid())
  organizationId String
  userId         String
  role           MemberRole @default(VIEWER)
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// YouTube domain (every row is reachable from an Organization for tenant isolation)
// ---------------------------------------------------------------------------

model Channel {
  id               String   @id @default(uuid())
  organizationId   String
  youtubeChannelId String
  title            String
  niche            String
  language         String   @default("en")
  country          String?

  // AES-256-GCM ciphertext (see ENCRYPTION_KEY). Never store plaintext tokens.
  refreshTokenEnc String?   @db.Text
  tokenScopes     String[]
  connectedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  topics       Topic[]
  videos       Video[]

  @@unique([organizationId, youtubeChannelId])
  @@index([organizationId])
  @@map("channels")
}

model Topic {
  id        String @id @default(uuid())
  channelId String
  title     String

  // Raw inputs plus the normalized 0-100 score computed by the research engine.
  searchVolume     Int?
  competition      Float?
  rpmEstimate      Float?
  viralityScore    Float?
  opportunityScore Float?

  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  videos  Video[]

  @@index([channelId, opportunityScore])
  @@map("topics")
}

model Video {
  id        String  @id @default(uuid())
  channelId String
  topicId   String?

  title        String
  script       String?     @db.Text
  status       VideoStatus @default(DRAFT)
  failureReason String?    @db.Text
  thumbnailUrl String?
  youtubeVideoId String?   @unique

  views     Int     @default(0)
  revenue   Decimal @default(0) @db.Decimal(12, 4)
  retention Float?
  ctr       Float?

  approvedById String?
  approvedAt   DateTime?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  channel    Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  topic      Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  approvedBy User?            @relation("VideoApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  analytics  VideoAnalytics[]

  @@index([channelId, status])
  @@map("videos")
}

// One row per video per day. Plain Postgres is fine for years of data; Timescale can be added later.
model VideoAnalytics {
  id                String   @id @default(uuid())
  videoId           String
  date              DateTime @db.Date
  views             Int
  watchTimeMinutes  Float
  subscribersGained Int      @default(0)
  ctr               Float?
  retention         Float?

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, date])
  @@index([date])
  @@map("video_analytics")
}

// ---------------------------------------------------------------------------
// Usage, billing, audit
// ---------------------------------------------------------------------------

// Provider-call cost tracking, one row per LLM request.
model LlmUsage {
  id             String   @id @default(uuid())
  organizationId String
  provider       String
  model          String
  feature        String
  inputTokens    Int
  outputTokens   Int
  costUsd        Decimal  @db.Decimal(12, 6)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("llm_usage")
}

// Append-only. Balance = SUM(delta). Positive = grant/purchase, negative = spend.
model CreditLedger {
  id             String   @id @default(uuid())
  organizationId String
  delta          Int
  reason         String
  feature        String?
  refId          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("credit_ledger")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
